# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cmhash

# JWT
JWT_SECRET=change-this-to-a-long-random-secret

# Server
PORT=4000
FRONTEND_URL=https://mchash.site

# Blockchain
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BNB_RPC_URL=https://bsc-dataseed.binance.org

# Treasury Wallets (set by admin)
SOLANA_TREASURY=
ETHEREUM_TREASURY=
BNB_TREASURY=

# Optional: CoinGecko demo API key — raises market-price rate limits.
# Get one free at https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# ---------------------------------------------------------------------------
# Currency conversion (manual deposits) — SECRET, backend-only.
# Never expose these keys to the frontend or in any API response.
# ExchangeRate API (fiat rates): https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=your-exchangerate-api-key
# CoinMarketCap Pro (crypto prices): https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key

# ---------------------------------------------------------------------------
# First-admin bootstrap  (run ONCE on a fresh database:  npm run setup:admin)
# These are NEVER hard-coded in source — read from your environment / .env.
# Provide the required values in backend/.env (git-ignored) or the deploy dashboard.
# Optional vars fall back to secure defaults shown below.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Admin User
ADMIN_USERNAME=admin
ADMIN_COUNTRY=Not specified
ADMIN_ROLE=SUPER_ADMIN
ADMIN_STATUS=active
