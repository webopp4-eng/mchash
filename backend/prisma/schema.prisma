generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminSetting {
  id        String   @id @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model AuditLog {
  id        String   @id @db.Uuid
  userId    String?  @db.Uuid
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([userId])
}

model Deposit {
  id            String    @id @db.Uuid
  userId        String    @db.Uuid
  walletAddress String
  chain         String
  amount        Decimal   @db.Decimal(18, 8)
  token         String
  txHash        String    @unique
  status        String    @default("pending")
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([txHash])
  @@index([userId])
}

model HashRentingPlan {
  id                  String                @id @db.Uuid
  name                String
  description         String?
  price               Decimal               @db.Decimal(18, 8)
  currency            String                @default("USDT")
  chain               String                @default("ethereum")
  hashPower           Decimal               @db.Decimal(18, 8)
  durationDays        Int
  expectedYield       Decimal               @default(0) @db.Decimal(18, 8)
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  HashRentingPurchase HashRentingPurchase[]
}

model HashRentingPurchase {
  id              String          @id @db.Uuid
  userId          String          @db.Uuid
  planId          String          @db.Uuid
  amount          Decimal         @db.Decimal(18, 8)
  currency        String
  chain           String
  txHash          String?
  status          String          @default("active")
  startedAt       DateTime        @default(now())
  endsAt          DateTime
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  HashRentingPlan HashRentingPlan @relation(fields: [planId], references: [id])
  User            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([userId])
}

model LoginHistory {
  id            String   @id @db.Uuid
  userId        String   @db.Uuid
  walletAddress String
  chain         String
  deviceInfo    String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MiningPlan {
  id             String           @id @db.Uuid
  name           String
  description    String?
  price          Decimal          @db.Decimal(18, 8)
  currency       String           @default("USDT")
  chain          String
  hashRate       Decimal          @db.Decimal(18, 8)
  dailyRate      Decimal          @db.Decimal(18, 8)
  durationDays   Int
  bonusReward    Decimal          @default(0) @db.Decimal(18, 8)
  referralBonus  Decimal          @default(0) @db.Decimal(18, 8)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  expectedReturn Decimal          @default(0) @db.Decimal(18, 8)
  MiningPurchase MiningPurchase[]
}

model MiningPurchase {
  id          String     @id @db.Uuid
  userId      String     @db.Uuid
  planId      String     @db.Uuid
  amount      Decimal    @db.Decimal(18, 8)
  currency    String
  chain       String
  txHash      String?
  status      String     @default("active")
  startedAt   DateTime   @default(now())
  endsAt      DateTime
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  MiningPlan  MiningPlan @relation(fields: [planId], references: [id])
  User        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([userId])
}

model MiningSession {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  purchaseId   String?   @db.Uuid
  hashRate     Decimal   @db.Decimal(18, 8)
  status       String    @default("active")
  startedAt    DateTime  @default(now())
  lastPayoutAt DateTime?
  totalMined   Decimal   @default(0) @db.Decimal(18, 8)
  createdAt    DateTime  @default(now())
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([read])
  @@index([userId])
}

model Referral {
  id              String            @id @db.Uuid
  userId          String            @unique @db.Uuid
  code            String            @unique
  totalReferrals  Int               @default(0)
  activeReferrals Int               @default(0)
  totalEarned     Decimal           @default(0) @db.Decimal(18, 8)
  createdAt       DateTime          @default(now())
  User            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ReferralEarning ReferralEarning[]
}

model ReferralEarning {
  id         String   @id @db.Uuid
  referralId String   @db.Uuid
  userId     String   @db.Uuid
  amount     Decimal  @db.Decimal(18, 8)
  level      Int      @default(1)
  sourceType String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  Referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([referralId])
}

model SupportMessage {
  id            String        @id @db.Uuid
  ticketId      String        @db.Uuid
  senderId      String?       @db.Uuid
  senderRole    String        @default("user")
  message       String
  createdAt     DateTime      @default(now())
  SupportTicket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SupportTicket {
  id             String           @id @db.Uuid
  userId         String           @db.Uuid
  subject        String
  category       String
  priority       String           @default("normal")
  status         String           @default("open")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  SupportMessage SupportMessage[]
  User           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  type      String
  amount    Decimal  @db.Decimal(18, 8)
  currency  String
  chain     String
  txHash    String?
  status    String   @default("completed")
  metadata  Json?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([userId])
}

model TreasuryTransaction {
  id             String         @id @db.Uuid
  walletId       String         @db.Uuid
  type           String
  txHash         String
  fromAddress    String?
  toAddress      String?
  amount         Decimal        @db.Decimal(18, 8)
  currency       String
  status         String         @default("confirmed")
  createdAt      DateTime       @default(now())
  TreasuryWallet TreasuryWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

model TreasuryWallet {
  id                  String                @id @db.Uuid
  network             String                @unique
  address             String
  label               String?
  active              Boolean               @default(true)
  balance             Decimal               @default(0) @db.Decimal(18, 8)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  supportedCurrency   String                @default("USDT")
  TreasuryTransaction TreasuryTransaction[]
}

model User {
  id                  String                @id @db.Uuid
  walletAddress       String?
  chain               String?
  walletType          String?
  username            String?               @unique
  referralCode        String                @unique
  referredBy          String?               @db.Uuid
  status              String                @default("active")
  role                String                @default("user")
  platformBalance     Decimal               @default(0) @db.Decimal(18, 8)
  totalEarned         Decimal               @default(0) @db.Decimal(18, 8)
  totalDeposited      Decimal               @default(0) @db.Decimal(18, 8)
  totalWithdrawn      Decimal               @default(0) @db.Decimal(18, 8)
  lastLoginAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  authMethod          String                @default("WALLET")
  country             String?
  email               String?               @unique
  emailVerifiedAt     DateTime?
  fullName            String?
  passwordHash        String?
  AuditLog            AuditLog[]
  Deposit             Deposit[]
  HashRentingPurchase HashRentingPurchase[]
  LoginHistory        LoginHistory[]
  MiningPurchase      MiningPurchase[]
  MiningSession       MiningSession[]
  Notification        Notification[]
  Referral            Referral?
  ReferralEarning     ReferralEarning[]
  SupportTicket       SupportTicket[]
  Transaction         Transaction[]
  Wallet              Wallet[]
  Withdrawal          Withdrawal[]

  @@index([authMethod])
  @@index([email])
  @@index([username])
  @@index([walletAddress])
}

model Wallet {
  id         String    @id @db.Uuid
  userId     String    @db.Uuid
  chain      String
  address    String
  balance    Decimal   @default(0) @db.Decimal(18, 8)
  token      String?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  verifiedAt DateTime?
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chain, address])
  @@index([address])
  @@index([userId])
}

model Withdrawal {
  id                 String    @id @db.Uuid
  userId             String    @db.Uuid
  amount             Decimal   @db.Decimal(18, 8)
  currency           String
  chain              String
  destinationAddress String
  status             String    @default("pending")
  txHash             String?
  adminNote          String?
  requestedAt        DateTime  @default(now())
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  User               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
